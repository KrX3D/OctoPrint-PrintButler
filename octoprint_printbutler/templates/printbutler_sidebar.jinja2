{# OctoPrint-PrintButler - printbutler_sidebar.jinja2 #}

<!-- ko if: autoShutdownFeatureEnabled -->
<div class="control-group" style="margin-bottom:6px;">
    <label class="checkbox" style="margin:0; cursor:pointer;">
        <input type="checkbox" data-bind="checked: armed, click: toggleArmed">
        {{ _("Auto-shutdown when cool") }}
    </label>
</div>
<p class="muted" style="margin:0; font-size:11px;" data-bind="visible: !cooldownCounting()">
    <span data-bind="text: armedTooltip"></span>
</p>
<p class="muted" style="margin:0; font-size:11px;" data-bind="visible: cooldownCounting">
    {{ _("Cooling down - shutdown in") }} <strong data-bind="text: cooldownSecondsText"></strong>
</p>
<!-- /ko -->
<!-- ko ifnot: autoShutdownFeatureEnabled -->
<p class="muted" style="margin:0; font-size:11px;">
    {{ _("Enable Safe Shutdown in PrintButler's settings to arm/disarm it here.") }}
</p>
<!-- /ko -->
