{# OctoPrint-PrintButler - printbutler_settings.jinja2 #}

<div id="settings_plugin_printbutler">

    <div class="printbutler-master-toggle">
        <input type="checkbox" id="printbutler_enabled"
               data-bind="checked: settings.enabled">
        <label for="printbutler_enabled">{{ _("Enable PrintButler") }}</label>
        <span class="muted" style="font-size:11px; font-weight:normal;">
            {{ _("Version:") }} <span data-bind="text: pluginVersion"></span>
        </span>
        <span class="printbutler-mqtt-badge" data-bind="css: mqttBadgeClass, text: mqttBadgeText"></span>
    </div>

    <ul class="nav nav-tabs" id="printbutler_tabs">
        <li class="active"><a href="#printbutler_tab_finish"  data-toggle="tab">{{ _("Print Finished") }}</a></li>
        <li><a href="#printbutler_tab_light"  data-toggle="tab">{{ _("Finish Light") }}</a></li>
        <li><a href="#printbutler_tab_shared" data-toggle="tab">{{ _("Shared Light") }}</a></li>
        <li><a href="#printbutler_tab_shutdown" data-toggle="tab">{{ _("Safe Shutdown") }}</a></li>
        <li><a href="#printbutler_tab_status" data-toggle="tab"
               data-bind="click: refreshStatus">{{ _("Status / Log") }}</a></li>
    </ul>

    <div class="tab-content" style="padding-top:14px;">

        <!-- ============================== Print Finished ============================== -->
        <div class="tab-pane active" id="printbutler_tab_finish">
            <p class="printbutler-section-heading">{{ _("Print Finished Notification") }}</p>
            <p class="muted">
                {{ _("Fires once, on OctoPrint's own \"print done\" event - no polling or MQTT progress tracking needed. Typically used to trigger a WLED effect, light flash, or any other MQTT-driven notification.") }}
            </p>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settings.finish_enabled">
                        {{ _("Publish an MQTT notification when a print finishes") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Topic") }}</label>
                <div class="controls">
                    <input type="text" class="input-block-level"
                           data-bind="value: settings.finish_topic, enable: settings.finish_enabled"
                           placeholder="wled/all/3dPrinterFinished">
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Payload (on / off)") }}</label>
                <div class="controls">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.finish_payload_on, enable: settings.finish_enabled"
                           placeholder="true">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.finish_payload_off, enable: settings.finish_enabled"
                           placeholder="false">
                    <span class="help-inline muted">{{ _("Payload sent, then reverted after the delay below.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("QoS / Retain") }}</label>
                <div class="controls">
                    <select style="width:70px; display:inline-block;"
                            data-bind="value: settings.finish_qos, enable: settings.finish_enabled">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                    </select>
                    <label class="checkbox" style="display:inline-block; margin-left:14px;">
                        <input type="checkbox" data-bind="checked: settings.finish_retain, enable: settings.finish_enabled">
                        {{ _("Retain") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Revert after (seconds)") }}</label>
                <div class="controls">
                    <input type="number" min="0" style="width:80px;"
                           data-bind="value: settings.finish_revert_after, enable: settings.finish_enabled">
                    <span class="help-inline muted">{{ _("0 = never revert, stays on the \"on\" payload.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button class="btn btn-small"
                            data-bind="click: testFinishNotify, enable: settings.finish_enabled() && !testFinishNotifyBusy(), css: {disabled: testFinishNotifyBusy}">
                        <i class="fa fa-flask"></i> {{ _("Test") }}
                    </button>
                </div>
            </div>

            <hr style="margin:14px 0 10px;">
            <p class="printbutler-section-heading">{{ _("Quiet Hours") }}</p>
            <p class="muted">
                {{ _("During this window, the finish notification, the finish light, and the shared-light-on-finish action are all suppressed. Plug-follows-light control below is unaffected.") }}
            </p>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settings.quiet_hours_enabled">
                        {{ _("Enable quiet hours") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("From / To") }}</label>
                <div class="controls">
                    <input type="time" style="width:110px;"
                           data-bind="value: settings.quiet_hours_start, enable: settings.quiet_hours_enabled">
                    <span>&ndash;</span>
                    <input type="time" style="width:110px;"
                           data-bind="value: settings.quiet_hours_end, enable: settings.quiet_hours_enabled">
                    <span class="help-inline muted">{{ _("Can cross midnight, e.g. 22:00 → 10:00.") }}</span>
                </div>
            </div>
        </div>

        <!-- ============================== Finish Light ============================== -->
        <div class="tab-pane" id="printbutler_tab_light">
            <p class="printbutler-section-heading">{{ _("Per-Printer Finish Indicator Light") }}</p>
            <p class="muted">
                {{ _("A dedicated light/relay for this printer only, turned on when this printer finishes a print.") }}
            </p>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settings.finish_light_enabled">
                        {{ _("Turn on a light/relay when this printer finishes") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Topic") }}</label>
                <div class="controls">
                    <input type="text" class="input-block-level"
                           data-bind="value: settings.finish_light_topic, enable: settings.finish_light_enabled"
                           placeholder="zigbee2mqtt/3D Drucker Licht Relais 1/set">
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Payload (on / off)") }}</label>
                <div class="controls">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.finish_light_payload_on, enable: settings.finish_light_enabled"
                           placeholder="ON">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.finish_light_payload_off, enable: settings.finish_light_enabled"
                           placeholder="OFF">
                    <span class="help-inline muted">{{ _("Plain text for most devices (WLED, Tasmota, HA-style switches). Some Zigbee2MQTT converters need JSON instead, e.g. {\"state\": \"ON\"}.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("QoS / Retain") }}</label>
                <div class="controls">
                    <select style="width:70px; display:inline-block;"
                            data-bind="value: settings.finish_light_qos, enable: settings.finish_light_enabled">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                    </select>
                    <label class="checkbox" style="display:inline-block; margin-left:14px;">
                        <input type="checkbox" data-bind="checked: settings.finish_light_retain, enable: settings.finish_light_enabled">
                        {{ _("Retain") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Turn off after (seconds)") }}</label>
                <div class="controls">
                    <input type="number" min="0" style="width:80px;"
                           data-bind="value: settings.finish_light_turn_off_after, enable: settings.finish_light_enabled">
                    <span class="help-inline muted">{{ _("0 = leave it on until the next print starts.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button class="btn btn-small"
                            data-bind="click: testFinishLight, enable: settings.finish_light_enabled() && !testFinishLightBusy(), css: {disabled: testFinishLightBusy}">
                        <i class="fa fa-flask"></i> {{ _("Test (3s)") }}
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================== Shared Light ============================== -->
        <div class="tab-pane" id="printbutler_tab_shared">
            <p class="printbutler-section-heading">{{ _("Shared Work Light") }}</p>
            <p class="muted">
                {{ _("A light/relay shared across multiple printers, kept on as long as THIS printer (i.e. this PrintButler/OctoPrint instance is running - it shares power with the printer, so \"running\" already means \"powered\") OR any peer printer's topic reports \"on\". Each PrintButler instance runs this independently - list the other printers' plug state topics as peers.") }}
            </p>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settings.shared_light_enabled">
                        {{ _("Keep the shared light on while any tracked printer is powered") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Set topic (publish)") }}</label>
                <div class="controls">
                    <input type="text" class="input-block-level"
                           data-bind="value: settings.shared_light_set_topic, enable: settings.shared_light_enabled"
                           placeholder="zigbee2mqtt/3D Drucker Licht/set">
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Set payload (on / off)") }}</label>
                <div class="controls">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.shared_light_payload_on, enable: settings.shared_light_enabled"
                           placeholder="ON">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.shared_light_payload_off, enable: settings.shared_light_enabled"
                           placeholder="OFF">
                    <span class="help-inline muted">{{ _("Plain text for most devices (WLED, Tasmota, HA-style switches). Some Zigbee2MQTT converters need JSON instead, e.g. {\"state\": \"ON\"}.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("QoS / Retain") }}</label>
                <div class="controls">
                    <select style="width:70px; display:inline-block;"
                            data-bind="value: settings.shared_light_qos, enable: settings.shared_light_enabled">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                    </select>
                    <label class="checkbox" style="display:inline-block; margin-left:14px;">
                        <input type="checkbox" data-bind="checked: settings.shared_light_retain, enable: settings.shared_light_enabled">
                        {{ _("Retain") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("State topic (optional, self-heal)") }}</label>
                <div class="controls">
                    <input type="text" class="input-block-level"
                           data-bind="value: settings.shared_light_state_topic, enable: settings.shared_light_enabled"
                           placeholder="zigbee2mqtt/3D Drucker Licht">
                    <input type="text" style="width:150px;"
                           data-bind="value: settings.shared_light_state_json_key, enable: settings.shared_light_enabled"
                           placeholder="state">
                    <span class="help-inline muted">{{ _("JSON field to read the on/off value from (blank = plain-text payload). If set, PrintButler re-asserts \"on\" if something else switches it off while a printer is still running.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Peer printer topics") }}</label>
                <div class="controls">
                    <textarea rows="4" class="input-block-level"
                              data-bind="value: settings.shared_light_peer_topics, enable: settings.shared_light_enabled"
                              placeholder="zigbee2mqtt/Prusa Rechts Zigbee Plug"></textarea>
                    <input type="text" style="width:150px;"
                           data-bind="value: settings.shared_light_peer_payload_on, enable: settings.shared_light_enabled"
                           placeholder="ON">
                    <input type="text" style="width:150px;"
                           data-bind="value: settings.shared_light_peer_json_key, enable: settings.shared_light_enabled"
                           placeholder="state">
                    <span class="help-inline muted">{{ _("One MQTT topic per line, plus the \"on\" value and the JSON field to read it from (blank = plain-text payload). Same format assumed for all peers.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button class="btn btn-small"
                            data-bind="click: testSharedLight, enable: settings.shared_light_enabled() && !testSharedLightBusy(), css: {disabled: testSharedLightBusy}">
                        <i class="fa fa-flask"></i> {{ _("Test (3s)") }}
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================== Safe Shutdown ============================== -->
        <div class="tab-pane" id="printbutler_tab_shutdown">
            <p class="printbutler-section-heading">{{ _("Safe Shutdown") }}</p>
            <p class="muted">
                {{ _("This host cannot cut its own mains power reliably - once the shutdown command runs, OctoPrint (and MQTT) will die before it can finish. Instead, PrintButler publishes a trigger topic BEFORE shutting down; wire up a Home Assistant automation (or similar) that watches this topic and cuts power to the printer plug once it has confirmed the host is actually down.") }}
            </p>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settings.shutdown_enabled">
                        {{ _("Enable Safe Shutdown") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Shutdown command") }}</label>
                <div class="controls">
                    <input type="text" class="input-block-level"
                           data-bind="value: settings.shutdown_command, enable: settings.shutdown_enabled"
                           placeholder="sudo shutdown -h now">
                    <span class="help-inline muted">{{ _("Runs on the OctoPrint host. Needs passwordless sudo for shutdown if using \"sudo\".") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Trigger topic (publish)") }}</label>
                <div class="controls">
                    <input type="text" class="input-block-level"
                           data-bind="value: settings.shutdown_trigger_topic, enable: settings.shutdown_enabled"
                           placeholder="printbutler/prusa_links/shutdown">
                    <span class="help-inline muted">{{ _("Published right before the shutdown command runs. Point a Home Assistant automation at this topic to cut mains power safely.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Trigger payload (on / off)") }}</label>
                <div class="controls">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.shutdown_trigger_payload_on, enable: settings.shutdown_enabled"
                           placeholder="ON">
                    <input type="text" style="width:150px; display:inline-block;"
                           data-bind="value: settings.shutdown_trigger_payload_off, enable: settings.shutdown_enabled"
                           placeholder="OFF">
                    <span class="help-inline muted">{{ _("\"On\" is published right before shutdown; \"off\" is published back on the next startup, so a retained topic doesn't stay stuck \"on\" and your automation gets a clean signal the host came back up.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("QoS / Retain") }}</label>
                <div class="controls">
                    <select style="width:70px; display:inline-block;"
                            data-bind="value: settings.shutdown_trigger_qos, enable: settings.shutdown_enabled">
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                    </select>
                    <label class="checkbox" style="display:inline-block; margin-left:14px;">
                        <input type="checkbox" data-bind="checked: settings.shutdown_trigger_retain, enable: settings.shutdown_enabled">
                        {{ _("Retain") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Settle delay (seconds)") }}</label>
                <div class="controls">
                    <input type="number" min="0" style="width:80px;"
                           data-bind="value: settings.shutdown_trigger_settle_seconds, enable: settings.shutdown_enabled">
                    <span class="help-inline muted">{{ _("Wait this long after publishing the trigger before running the shutdown command, so the message has time to actually leave the host.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button class="btn btn-small"
                            data-bind="click: testShutdownTrigger, enable: settings.shutdown_enabled() && !testShutdownTriggerBusy(), css: {disabled: testShutdownTriggerBusy}">
                        <i class="fa fa-flask"></i> {{ _("Test Trigger Only") }}
                    </button>
                    <span class="help-inline muted">{{ _("Publishes the trigger topic so you can verify your automation reacts - does NOT run the shutdown command.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button class="btn btn-danger"
                            data-bind="click: shutdownNow, enable: settings.shutdown_enabled() && !shutdownBusy(), css: {disabled: shutdownBusy}">
                        <i class="fa fa-power-off"></i> {{ _("Shutdown Printer Now") }}
                    </button>
                    <span class="printbutler-shutdown-result" data-bind="visible: shutdownBusy">
                        {{ _("Shutdown in progress...") }}
                    </span>
                </div>
            </div>

            <hr style="margin:14px 0 10px;">
            <p class="printbutler-section-heading">{{ _("Auto-Shutdown When Cool") }}</p>
            <p class="muted">
                {{ _("Continuously watches the bed and nozzle temperature - not just after a print - and once both stay below their thresholds for the confirm time while the printer isn't printing, triggers Safe Shutdown automatically, same as pressing the button above. This includes right after OctoPrint (re)starts if the printer is already idle and cool. It disarms itself once it fires (see below), and re-arms automatically the next time OctoPrint starts.") }}
            </p>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settings.auto_shutdown_enabled, enable: settings.shutdown_enabled">
                        {{ _("Enable auto-shutdown when cool") }}
                    </label>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Bed / Nozzle threshold (°C)") }}</label>
                <div class="controls">
                    <input type="number" step="0.1" style="width:80px; display:inline-block;"
                           data-bind="value: settings.auto_shutdown_bed_threshold, enable: settings.auto_shutdown_enabled">
                    <input type="number" step="0.1" style="width:80px; display:inline-block;"
                           data-bind="value: settings.auto_shutdown_tool_threshold, enable: settings.auto_shutdown_enabled">
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">{{ _("Confirm for (seconds)") }}</label>
                <div class="controls">
                    <input type="number" min="0" style="width:80px;"
                           data-bind="value: settings.auto_shutdown_confirm_seconds, enable: settings.auto_shutdown_enabled">
                    <span class="help-inline muted">{{ _("Both temperatures must stay at or below their threshold for this long before shutdown fires.") }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <p class="muted">
                        {{ _("Controlled live by the power button in the top navigation bar - armed by default on every OctoPrint start; click it to disarm for the current session (e.g. to keep the printer on after this print).") }}
                        {{ _("Currently:") }}
                        <strong data-bind="visible: armed" style="color:#3c763d;">{{ _("Armed") }}</strong><!--
                        --><strong data-bind="visible: !armed()" style="color:#a94442;">{{ _("Disarmed") }}</strong>
                    </p>
                    <p class="muted" data-bind="visible: cooldownCounting">
                        {{ _("Currently counting down:") }} <strong data-bind="text: cooldownSecondsText"></strong>
                    </p>
                </div>
            </div>
        </div>

        <!-- ============================== Status / Log ============================== -->
        <div class="tab-pane" id="printbutler_tab_status">
            <p class="printbutler-section-heading">{{ _("Live Status") }}</p>

            <table class="table table-condensed" style="width:auto;">
                <tbody>
                    <tr>
                        <td>{{ _("MQTT helper") }}</td>
                        <td><span data-bind="css: mqttBadgeClass, text: mqttBadgeText" class="printbutler-status-badge"></span></td>
                    </tr>
                    <tr>
                        <td>{{ _("This printer") }}</td>
                        <td data-bind="text: thisPrinterActiveText"></td>
                    </tr>
                    <tr>
                        <td>{{ _("Shared light desired state") }}</td>
                        <td data-bind="text: sharedLightText"></td>
                    </tr>
                    <tr>
                        <td>{{ _("Quiet hours active now") }}</td>
                        <td data-bind="text: quietHoursText"></td>
                    </tr>
                    <tr>
                        <td>{{ _("Auto-shutdown-when-cool") }}</td>
                        <td>
                            <span data-bind="visible: armed">{{ _("Armed") }}</span><!--
                            --><span data-bind="visible: !armed()">{{ _("Disarmed") }}</span><!--
                            --><span data-bind="visible: cooldownCounting"> - <span data-bind="text: cooldownSecondsText"></span></span>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="control-group">
                <div class="controls">
                    <button class="btn btn-small" data-bind="click: refreshStatus">
                        <i class="fa fa-refresh"></i> {{ _("Refresh") }}
                    </button>
                    <button class="btn btn-small" data-bind="click: clearLogs">
                        <i class="fa fa-trash"></i> {{ _("Clear log") }}
                    </button>
                </div>
            </div>

            <!-- ko if: logs().length > 0 -->
            <div id="printbutler_log_area" class="printbutler-log"
                 data-bind="foreach: logs">
                <div class="log-line" data-bind="text: $data, css: $parent.logLineClass($data)"></div>
            </div>
            <!-- /ko -->
        </div>

    </div>
</div>
