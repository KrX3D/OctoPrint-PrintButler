msgstr "MQTT-Verbindung"

msgid "This printer"
msgstr "Dieser Drucker"

msgid "Shared light desired state"
msgstr "Sollzustand gemeinsames Licht"

msgid "Quiet hours active now"
msgstr "Ruhezeit gerade aktiv"

msgid "Auto-shutdown-when-cool"
msgstr "Auto-Shutdown nach Abkühlen"

msgid "Refresh"
msgstr "Aktualisieren"

msgid "Clear log"
msgstr "Log leeren"

msgid "MQTT connected"
msgstr "MQTT verbunden"

msgid "MQTT plugin not found"
msgstr "MQTT-Plugin nicht gefunden"

msgid "MQTT not connected"
msgstr "MQTT nicht verbunden"

msgid "Unknown"
msgstr "Unbekannt"

msgid "On"
msgstr "An"

msgid "Off"
msgstr "Aus"

msgid "Yes"
msgstr "Ja"

msgid "No"
msgstr "Nein"

msgid "PrintButler"
msgstr "PrintButler"

msgid "Request failed."
msgstr "Anfrage fehlgeschlagen."

msgid "Test"
msgstr "Testen"

msgid "Test (3s)"
msgstr "Testen (3s)"

msgid "Test Trigger Only"
msgstr "Nur Trigger testen"

msgid "Publishes the trigger topic so you can verify your automation reacts - does NOT run the shutdown command."
msgstr "Sendet das Trigger-Topic, damit du prüfen kannst, ob deine Automatisierung reagiert - der Shutdown-Befehl wird NICHT ausgeführt."

msgid "Currently counting down:"
msgstr "Läuft gerade ab:"

msgid "{seconds}s"
msgstr "{seconds}s"

msgid "Done."
msgstr "Fertig."

msgid "Failed."
msgstr "Fehlgeschlagen."

msgid "PrintButler: auto-shutdown-when-cool is armed (click to disarm)"
msgstr "PrintButler: Auto-Shutdown nach Abkühlen ist aktiv (klicken zum Deaktivieren)"

msgid "PrintButler: auto-shutdown-when-cool is DISARMED (click to arm)"
msgstr "PrintButler: Auto-Shutdown nach Abkühlen ist DEAKTIVIERT (klicken zum Aktivieren)"
